#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/*
Function	Arduino pin	Nucleo GPIO	STM32 peripheral
Phase A PWM	D9	PC7	TIM3_CH2 / TIM8_CH2
Phase B PWM	D5	PB4	TIM3_CH1
Phase C PWM	D6	PB10	TIM2_CH3
Driver enable	D8	PA9	GPIO output
Phase A current	A0	PA0	ADC1/2 IN1
Phase B current	A2	PA4	ADC2 IN17
*/

/ {
    aliases {
        position-sensor = &as5600;
        motor-report = &uart4;

        phase-a-pwm = &phase_a_pwm;
        phase-b-pwm = &phase_b_pwm;
        phase-c-pwm = &phase_c_pwm;
        motor-enable = &motor_enable;
    };

    pwm_outputs {
	   	compatible = "pwm-leds";
	    phase_a_pwm: phase_a {
	        pwms = <&pwm3 1 PWM_HZ(20000) PWM_POLARITY_NORMAL>;
	    };
	
	    phase_b_pwm: phase_b {
	        pwms = <&pwm3 2 PWM_HZ(20000) PWM_POLARITY_NORMAL>;
	    };
	
	    phase_c_pwm: phase_c {
	        pwms = <&pwm2 3 PWM_HZ(20000) PWM_POLARITY_NORMAL>;
	    };
    };

    motor_outputs {
        compatible = "gpio-leds";
    
        motor_enable: enable {
            gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
        };
    };
};

&i2c1 {
    status = "okay";

    as5600: as5600@36 {
        compatible = "ams,as5600";
        reg = <0x36>;
        status = "okay";
    };
};

&uart4 {
    pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

&timers2 {
    status = "okay";

    pwm2: pwm {
        status = "okay";
        pinctrl-0 = <&tim2_ch3_pb10>;
        pinctrl-names = "default";
    };
};

&timers3 {
    status = "okay";
    
    st,prescaler = <0>;
    pwm3: pwm {
        status = "okay";
        pinctrl-0 = <&tim3_ch1_pb4 &tim3_ch2_pc7>;
        pinctrl-names = "default";
    };
};
